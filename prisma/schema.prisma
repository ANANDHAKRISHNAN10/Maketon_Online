datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String        @default("hashed_password_sample")
  role            String        @default("GAMER") // ADMIN, STAFF, GAMER
  parentEmail     String?
  parentalPinHash String?
  lastLoginIp     String?
  isFrozen        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  // Relations
  subscriptions   Subscription[]
  invoices        Invoice[]
  securityLogs    SecurityLog[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  basePrice   Float
  costPrice   Float
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  // Relations
  variants    ProductVariant[]
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String   // Standard, Pro Gamer Edition, Odoo Pass
  priceAdjustment Float    @default(0.0)
  createdAt       DateTime @default(now())

  // Relations
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  billingPeriod String         // DAILY, WEEKLY, MONTHLY, YEARLY
  price         Float
  autoClose     Boolean        @default(false)
  allowPause    Boolean        @default(true)
  maxPauseDays  Int            @default(14)
  createdAt     DateTime       @default(now())

  // Relations
  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  planId             String
  status             String    @default("ACTIVE") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, PAUSED, CLOSED
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  pauseStartDate     DateTime?
  pauseResumeDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices           Invoice[]
}

model Invoice {
  id             String    @id @default(cuid())
  subscriptionId String?
  userId         String
  amountSubtotal Float
  taxAmount      Float     // 18% GST
  discountAmount Float     @default(0.0)
  totalAmount    Float
  status         String    @default("CONFIRMED") // DRAFT, CONFIRMED, PAID, OVERDUE, CANCELLED
  dueDate        DateTime
  createdAt      DateTime  @default(now())

  // Relations
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String?  // Nullable to support unlinked payments (revenue leakage scenario d)
  amount    Float
  method    String   @default("CREDIT_CARD") // CREDIT_CARD, UPI, WALLET
  status    String   @default("SUCCESS") // SUCCESS, FAILED, CHARGEBACK
  createdAt DateTime @default(now())

  // Relations
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Discount {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   @default("PERCENT") // PERCENT, FIXED
  value       Float
  minQuantity Int      @default(1)
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for unauthenticated/bot attacks
  ipAddress String
  userAgent String?
  eventType String   // GEO_IP_JUMP, CARD_BOT_ATTACK, REVENUE_LEAKAGE
  details   String   // JSON string containing contextual attack details
  createdAt DateTime @default(now())

  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
